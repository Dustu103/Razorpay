# ── Postgres ──────────────────────────────────────────────────
DATABASE_URL=postgres://razorpay:razorpay@postgres:5432/razorpay_classifier?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Service ports ─────────────────────────────────────────────
INGESTION_PORT=3001
CLASSIFICATION_PORT=3002
AUDIT_PORT=3003
FRONTEND_PORT=3000

# ── Queue ─────────────────────────────────────────────────────
QUEUE_NAME=classification_jobs

# ── App ───────────────────────────────────────────────────────
APP_ENV=development

# ── Audit service URL (used by frontend BFF) ──────────────────
AUDIT_SERVICE_URL=http://audit-service:3003

# ── AI / LLM Keys (Layer 3 Classification) ────────────────────
# Get a FREE Groq key at: https://console.groq.com (no credit card needed)
# Uses llama-3.1-70b-versatile. If not set, Layer 3 falls back to heuristics.
GROQ_API_KEY=gsk_your_key_here
